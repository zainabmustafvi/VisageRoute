# Base URL of the VisageRoute backend (http or https).
# Read at build time by Expo and inlined into the app bundle.
# Copy this file to `.env` and set the value for your environment.
#
# Local development (same WiFi as your dev machine):
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.0.106:5000
#
# Shareable APK (public backend — recommended):
#   EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.106:5000
