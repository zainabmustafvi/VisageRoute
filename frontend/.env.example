# VisageRoute Mobile App Environment Configuration
# Read at build time by Expo and inlined into the client bundle.
# Copy this file to `.env` in the frontend directory.

# =======================================================================
# Option 1: Port Forwarding / Tunnel (Recommended for remote testing & devices)
# =======================================================================
# Ngrok tunnel:
#   EXPO_PUBLIC_API_BASE_URL=https://abc1-23-45-67.ngrok-free.app
# Localtunnel:
#   EXPO_PUBLIC_API_BASE_URL=https://visageroute-api.loca.lt
# VS Code / GitHub Dev Tunnel:
#   EXPO_PUBLIC_API_BASE_URL=https://xxxxx-5000.app.github.dev

# =======================================================================
# Option 2: Local Wi-Fi / LAN IP (Dev machine & phone on same Wi-Fi)
# =======================================================================
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.106:5000

# =======================================================================
# Option 3: Local Emulators
# =======================================================================
# Android Studio Emulator (10.0.2.2 points to host machine):
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000
# iOS Simulator (localhost):
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Active Base URL:
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.106:5000
